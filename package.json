{
  "name": "turn-into-a-jigsaw-puzzle",
  "version": "1.3.0",
  "description": "Desktop, web, and Android jigsaw puzzle game that converts any image into a playable puzzle.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --dir",
    "web": "node web-server.js",
    "android:build": "echo Use the android/ Gradle project or GitHub Actions workflow to build the APK"
  },
  "keywords": [
    "electron",
    "pwa",
    "jigsaw",
    "puzzle",
    "desktop-game",
    "android",
    "web",
    "apk",
    "mods"
  ],
  "author": "YanagiKH",
  "license": "MIT",
  "dependencies": {
    "electron": "^31.0.0"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yanagikh.turnintoajigsawpuzzle",
    "productName": "Turn into a Jigsaw Puzzle",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "mobile.css",
      "pwa.js",
      "web-server.js",
      "manifest.webmanifest",
      "sw.js",
      "mods/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
